# Telegram API application: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot token from @BotFather; never post this file in a chat.
BOT_TOKEN=
# Run: python app.py --login, then paste the printed numeric ID here.
OWNER_TELEGRAM_ID=
# Optional: folder name or ID. Can also be selected with /folder in the bot.
TELEGRAM_FOLDER=
# Personal HR chats for /responses; separate from vacancy-channel sources.
RESPONSES_FOLDER=Удаленки
POLL_SECONDS=30
HISTORY_LIMIT=100
# Telegram publication age in days, capped at 3 days (72 hours).
MAX_POST_AGE_DAYS=7
MAX_NOTIFICATIONS_PER_CYCLE=10

